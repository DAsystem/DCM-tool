KENNFELD LambdaMap 6 4
   LANGNAME      "空燃比目标图谱"
   FUNKTION      FUEL_SYS
   EINHEIT_X     "rpm"
   EINHEIT_Y     "mg/hub"
   EINHEIT_W     "-"
   ST/X          800.0   1500.0   2500.0   3500.0   4500.0   6000.0
   ST/Y          20.0    50.0    80.0   100.0
   WERT          1.00    1.00    1.00    1.00    0.97    0.95
