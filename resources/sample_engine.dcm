   WERT          1.00    1.00    0.98    0.95    0.92    0.90
   WERT          1.00    0.98    0.95    0.92    0.90    0.88
END

GRUPPENPARAMETER VehicleInfo
   LANGNAME      "车辆信息"
   FUNKTION      ENGINE_CTRL
   TEXT          "Project: Sample Engine ECU"
   TEXT          "Variant: Base"
   TEXT          "Date: 2024-01-15"
   TEXT          "Engineer: Test"
END

