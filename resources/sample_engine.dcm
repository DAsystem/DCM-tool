   WERT          12.0    15.0    18.0    21.0    24.0    26.0    23.0    19.0
END

KENNFELD AirMassMap_mg 8 5
   LANGNAME      "充气量图谱"
   FUNKTION      ENGINE_CTRL
   EINHEIT_X     "rpm"
   EINHEIT_Y     "%"
   EINHEIT_W     "mg/hub"
