KONSERVIERUNG_FORMAT 2.0

FUNKTIONEN
   FKT ENGINE_CTRL "发动机控制功能组" "V1.2"
   FKT FUEL_SYS "燃油系统" "V2.0"
   FKT IGNITION "点火系统" "V1.0"
END

KENNWERT IdleSpeed_rpm
   LANGNAME      "怠速转速"
   FUNKTION      ENGINE_CTRL
   EINHEIT_W     "rpm"
   VAR           WERT=750.0
END

KENNWERT MaxTorque_Nm
   LANGNAME      "最大扭矩限制"
   FUNKTION      ENGINE_CTRL
   EINHEIT_W     "Nm"
   VAR           WERT=320.0
END

KENNWERT CoolantTempOffset
   LANGNAME      "冷却液温度修正偏置"
   FUNKTION      ENGINE_CTRL
   EINHEIT_W     "degC"
   VAR           WERT=2.5
END

KENNWERT InjectorDeadTime_us
   LANGNAME      "喷射器死区时间"
   FUNKTION      FUEL_SYS
   EINHEIT_W     "us"
   VAR           WERT=350.0
END

KENNWERT LambdaTarget
   LANGNAME      "目标空燃比Lambda"
   FUNKTION      FUEL_SYS
   EINHEIT_W     "-"
   VAR           WERT=1.0
END

KENNWERT IgnitionAdvanceBase_deg
   LANGNAME      "基础点火提前角"
   FUNKTION      IGNITION
   EINHEIT_W     "deg"
   VAR           WERT=12.0
END

KENNLINIE CoolantTempFuelCorr 8
   LANGNAME      "冷却液温度燃油修正曲线"
   FUNKTION      FUEL_SYS
   EINHEIT_X     "degC"
   EINHEIT_W     "%"
   ST/X          -20.0   0.0   20.0   40.0   60.0   80.0   95.0   110.0
   WERT          30.0    18.0   9.0    4.0    1.5    0.0   -1.0   -2.0
END

KENNLINIE IntakeAirTempCorr 6
   LANGNAME      "进气温度修正系数"
   FUNKTION      FUEL_SYS
   EINHEIT_X     "degC"
   EINHEIT_W     "-"
   ST/X          -10.0   10.0   25.0   40.0   60.0   80.0
   WERT           1.08    1.04   1.00   0.97   0.93   0.88
END

KENNLINIE IdleSpeedTarget_rpm 5
   LANGNAME      "怠速目标转速 vs 冷却液温度"
   FUNKTION      ENGINE_CTRL
   EINHEIT_X     "degC"
   EINHEIT_W     "rpm"
   ST/X          -20.0   0.0   20.0   60.0   90.0
   WERT          1100.0  950.0  850.0  780.0  750.0
END

KENNLINIE ThrottleCharacteristic 10
   LANGNAME      "节气门特性曲线"
   FUNKTION      ENGINE_CTRL
   EINHEIT_X     "%"
   EINHEIT_W     "mg/hub"
   ST/X          0.0   10.0   20.0   30.0   40.0   50.0   60.0   70.0   80.0   100.0
   WERT          0.0    4.2    9.8   16.5   24.0   32.5   42.0   53.0   65.0    85.0
END

KENNLINIE InjPulseWidthCorr_VBatt 6
   LANGNAME      "喷射脉宽电池电压修正"
   FUNKTION      FUEL_SYS
   EINHEIT_X     "V"
   EINHEIT_W     "us"
   ST/X          9.0   11.0   12.0   13.0   14.0   16.0
   WERT          80.0   45.0   30.0   18.0    8.0    0.0
END

KENNFELD FuelInjMap_mg 8 5
   LANGNAME      "燃油喷射量基础图谱"
   FUNKTION      FUEL_SYS
   EINHEIT_X     "rpm"
   EINHEIT_Y     "mg/hub"
   EINHEIT_W     "ms"
